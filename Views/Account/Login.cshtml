@model InternalRequestSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <!-- LEFT SIDE -->

    <div class="login-left">

        <div class="login-brand">

            <div class="login-logo">
                IR
            </div>

            <div>
                <h1>Internal Request System</h1>

                <p>
                    Manage internal requests, approvals,
                    and activity tracking in one place.
                </p>
            </div>

        </div>

        <div class="login-features">

            <div class="feature-card">
                <h5>Request Management</h5>
                <p>Create and track internal requests easily.</p>
            </div>

            <div class="feature-card">
                <h5>Approval Workflow</h5>
                <p>Approve, reject, and review requests instantly.</p>
            </div>

            <div class="feature-card">
                <h5>Activity Timeline</h5>
                <p>Monitor all actions and updates in real time.</p>
            </div>

        </div>

    </div>

    <!-- RIGHT SIDE -->

    <div class="login-right">

        <div class="login-card">

            <h2 class="login-title">
                Welcome Back
            </h2>

            <p class="login-subtitle">
                Enter your information to continue
            </p>

            <form asp-action="Login" method="post">

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>

                    <input asp-for="FullName"
                           class="form-control login-input" />

                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>

                    <input asp-for="Email"
                           class="form-control login-input" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label"></label>

                    <select asp-for="Role" class="form-select login-input">
                        <option value="">Select Role</option>
                        <option value="Employee">Employee</option>
                        <option value="Manager">Manager</option>
                        <option value="Admin">Admin</option>
                    </select>

                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn login-btn w-100">
                        Login
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}