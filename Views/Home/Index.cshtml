@using InternalRequestSystem.Models

@{
    ViewData["Title"] = "Dashboard";

    var latestRequests = ViewBag.LatestRequests as List<Request>;
    var latestActivities = ViewBag.LatestActivities as List<RequestLog>;
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Welcome back, @ViewBag.FullName 👋
        </h2>

        <p class="text-muted mb-0">
            Here's what's happening today.
        </p>
    </div>

    <a asp-controller="Requests"
       asp-action="Create"
       class="btn btn-dark">
        + New Request
    </a>

</div>

<div class="row g-4 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="card stat-card border-start border-4 border-primary shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-1">Total Requests</p>
                <h2 class="fw-bold mb-0">@ViewBag.TotalRequests</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card stat-card border-start border-4 border-warning shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-1">Pending</p>
                <h2 class="fw-bold mb-0">@ViewBag.PendingRequests</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card stat-card border-start border-4 border-success shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-1">Approved</p>
                <h2 class="fw-bold mb-0">@ViewBag.ApprovedRequests</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card stat-card border-start border-4 border-danger shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-1">Rejected</p>
                <h2 class="fw-bold mb-0">@ViewBag.RejectedRequests</h2>
            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <div class="col-lg-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white fw-bold">
                Latest Requests
            </div>

            <div class="card-body">

                @if (latestRequests != null && latestRequests.Any())
                {
                    @foreach (var request in latestRequests)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">

                            <div>
                                <h6 class="fw-bold mb-1">
                                    @request.Title
                                </h6>

                                <small class="text-muted">
                                    @request.Department?.DepartmentName
                                </small>
                            </div>

                            <span class="badge
                                        @(request.Status == "Approved" ? "bg-success" :
                                                                    request.Status == "Rejected" ? "bg-danger" :
                                                                    request.Status == "Pending" ? "bg-warning text-dark" :
                                                                    "bg-secondary")">

                                        @request.Status
                            </span>

                        </div>
                                }
                }
                else
                {
                    <p class="text-muted mb-0">
                        No requests found.
                    </p>
                }

            </div>

        </div>

    </div>

    <div class="col-lg-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white fw-bold">
                Latest Activities
            </div>

            <div class="card-body">

                @if (latestActivities != null && latestActivities.Any())
                {
                    @foreach (var log in latestActivities)
                    {
                        <div class="timeline-item">

                            <div class="timeline-dot
                                        @(log.Action == "Approved" ? "bg-success" :
                                                                   log.Action == "Rejected" ? "bg-danger" :
                                                                   log.Action == "In Review" ? "bg-primary" :
                                                                   "bg-secondary")">
                    </div>

                            <div class="timeline-content">

                                <small class="text-muted">
                                    @log.ActionDate.ToString("dd MMM HH:mm")
                                </small>

                                <h6 class="fw-bold mb-1 mt-1">
                                    @log.Action
                                </h6>

                                <p class="text-muted mb-0">
                                    @log.Description
                                </p>

                            </div>

                        </div>
                                }
                }
                else
                {
                    <p class="text-muted mb-0">
                        No activities found.
                    </p>
                }

            </div>

        </div>

    </div>

</div>

