@model InternalRequestSystem.Models.Request

@{
    ViewData["Title"] = "Create Request";
}

<div class="form-page">

    <div class="form-header">
        <div>
            <span class="page-kicker">New internal request</span>

            <h2 class="fw-bold mb-1">
                Create Request
            </h2>

            <p class="text-muted mb-0">
                Fill in the details below to submit a new request.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>

    <div class="request-form-card">

        <form asp-action="Create" method="post">

            <div class="row g-4">

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">
                        Request Title
                    </label>

                    <input asp-for="Title"
                           class="form-control form-control-lg"
                           placeholder="Example: New laptop request" />

                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="RequestType" class="form-label">
                        Request Type
                    </label>

                    <input asp-for="RequestType"
                           class="form-control form-control-lg"
                           placeholder="Example: Equipment, Leave, Maintenance" />

                    <span asp-validation-for="RequestType" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Write a clear explanation about this request..."></textarea>

                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DepartmentId" class="form-label">
                        Department
                    </label>

                    <select asp-for="DepartmentId" class="form-select form-select-lg">
                        <option value="">Select Department</option>

                        @foreach (var dept in ViewBag.Departments)
                        {
                            <option value="@dept.Id">
                                @dept.DepartmentName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-light">
                    Cancel
                </a>

                <button type="submit" class="btn btn-success px-4">
                    Save Request
                </button>
            </div>

        </form>

    </div>

</div>
	<!--

asp-for      	بيربط مع Model
asp-action   	بيربط مع Controller
validation  	بيعرض الأخطاء

	-->
