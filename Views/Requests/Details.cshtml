@model InternalRequestSystem.Models.Request

@{
    ViewData["Title"] = "Request Details";

    var statusClass =
        Model.Status == "Approved" ? "bg-success" :
        Model.Status == "Rejected" ? "bg-danger" :
        Model.Status == "Pending" ? "bg-warning text-dark" :
        Model.Status == "In Review" ? "bg-primary" :
        "bg-secondary";
}

<div class="details-page">

    <div class="details-header">

        <div>
            <span class="page-kicker">Internal request</span>

            <h1 class="details-title">
                @Model.Title
            </h1>

            <p class="text-muted mb-0">
                Detailed request information and activity history.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                Delete
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="details-card">

                <div class="details-top">

                    <div>
                        <span class="details-label">
                            Request Status
                        </span>

                        <div class="mt-2">
                            <span class="badge fs-6 px-3 py-2 @statusClass">
                                @Model.Status
                            </span>
                        </div>
                    </div>

                    <div class="request-id-box">
                        #@Model.Id
                    </div>

                </div>

                <div class="details-grid">

                    <div class="details-info-card">
                        <span class="info-title">
                            Request Type
                        </span>

                        <h5>
                            @Model.RequestType
                        </h5>
                    </div>

                    <div class="details-info-card">
                        <span class="info-title">
                            Department
                        </span>

                        <h5>
                            @Model.Department?.DepartmentName
                        </h5>
                    </div>

                    <div class="details-info-card">
                        <span class="info-title">
                            Submitted By
                        </span>

                        <h5>
                            @Model.SubmittedByName
                        </h5>
                    </div>

                    <div class="details-info-card">
                        <span class="info-title">
                            Email
                        </span>

                        <h5 class="email-text">
                            @Model.SubmittedByEmail
                        </h5>
                    </div>

                    <div class="details-info-card">
                        <span class="info-title">
                            Created Date
                        </span>

                        <h5>
                            @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </h5>
                    </div>

                </div>

                <div class="description-card">

                    <span class="info-title">
                        Description
                    </span>

                    <p class="description-text">
                        @Model.Description
                    </p>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="timeline-card">

                <div class="timeline-header">
                    Activity Timeline
                </div>

                <div class="timeline-body">

                    @{
                        var logs = ViewBag.RequestLogs as List<InternalRequestSystem.Models.RequestLog>;
                    }

                    @if (logs != null && logs.Any())
                    {
                        @foreach (var log in logs)
                        {
                            <div class="timeline-modern-item">

                                <div class="timeline-modern-dot
                                            @(log.Action == "Approved" ? "bg-success" :
                                                                           log.Action == "Rejected" ? "bg-danger" :
                                                                           log.Action == "In Review" ? "bg-primary" :
                                                                           "bg-secondary")">
                        </div>

                                <div class="timeline-modern-content">

                                    <small class="text-muted">
                                        @log.ActionDate.ToString("dd MMM yyyy - HH:mm")
                                    </small>

                                    <h6 class="fw-bold mt-1 mb-1">
                                        @log.Action
                                    </h6>

                                    <p class="text-muted mb-0">
                                        @log.Description
                                    </p>

                                </div>

                            </div>
                                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No activity found.
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>