@model InternalRequestSystem.Models.Request

@{
    ViewData["Title"] = "Request Details";
}

<div class="row">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Request Details</h2>
                <p class="text-muted mb-0">
                    Detailed information about the selected request.
                </p>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Request ID
                    </div>

                    <div class="col-md-8">
                        @Model.Id
                    </div>
                </div>

                <hr />

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Title
                    </div>

                    <div class="col-md-8">
                        @Model.Title
                    </div>
                </div>

                <hr />

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Description
                    </div>

                    <div class="col-md-8">
                        @Model.Description
                    </div>
                </div>

                <hr />

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Request Type
                    </div>

                    <div class="col-md-8">
                        @Model.RequestType
                    </div>
                </div>

                <hr />

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Status
                    </div>

                    <div class="col-md-8">

                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }

                    </div>
                </div>

                <hr />

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Submitted By
                    </div>

                    <div class="col-md-8">
                        @Model.SubmittedByName
                    </div>
                </div>

                <hr />

                <div class="row mb-4">
                    <div class="col-md-4 fw-bold">
                        Email
                    </div>

                    <div class="col-md-8">
                        @Model.SubmittedByEmail
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        Edit Request
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">
                        Delete Request
                    </a>
                </div>

            </div>
        </div>



    </div>

    <div class="col-lg-4">

        <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">

            <div class="card-header bg-dark text-white">
                Activity Timeline
            </div>

            <div class="card-body" style="max-height: 600px; overflow-y: auto; padding-top: 1.5rem;">

                @{
                    var logs = ViewBag.RequestLogs as List<InternalRequestSystem.Models.RequestLog>;
                }

                @if (logs != null && logs.Any())
                {
                    @foreach (var log in logs)
                    {
                        <div class="mb-4 border-start border-3 ps-3">

                            <h6 class="fw-bold mb-1">
                                @log.Action
                            </h6>

                            <small class="text-muted">
                                @log.ActionDate.ToString("dd.MM.yyyy HH:mm")
                            </small>

                            <p class="mb-0 mt-1">
                                @log.Description
                            </p>

                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">
                        No activity found.
                    </p>
                }

            </div>

        </div>

    </div>

</div>