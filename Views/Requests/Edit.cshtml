@model InternalRequestSystem.Models.Request

@{
    ViewData["Title"] = "Edit Request";
}

<div class="form-page">

    <div class="form-header">
        <div>
            <span class="page-kicker">Update internal request</span>

            <h2 class="fw-bold mb-1">
                Edit Request
            </h2>

            <p class="text-muted mb-0">
                Update the request information and current status.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>

    <div class="request-form-card">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="row g-4">

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">
                        Request Title
                    </label>

                    <input asp-for="Title"
                           class="form-control form-control-lg" />

                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="RequestType" class="form-label">
                        Request Type
                    </label>

                    <input asp-for="RequestType"
                           class="form-control form-control-lg" />

                    <span asp-validation-for="RequestType" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Current Status
                    </label>

                    <div class="form-control form-control-lg bg-light">
                        @Model.Status
                    </div>
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-light">
                    Cancel
                </a>

                <button type="submit" class="btn btn-warning px-4">
                    Update Request
                </button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}