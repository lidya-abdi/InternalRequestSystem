@using Microsoft.AspNetCore.Http
@model List<InternalRequestSystem.Models.Request>

@{
    ViewData["Title"] = "Requests List";
}

@{
    var role = Context.Session.GetString("Role");
    bool canManage = role == "Manager" || role == "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Requests List</h2>
        <p class="text-muted mb-0">Welcome, @ViewBag.FullName</p>
        <p class="text-muted small mb-0">
            Total Requests: @Model.Count
        </p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Create New Request
    </a>
</div>

<form asp-action="Index" method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">

            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text"
                       name="searchText"
                       value="@ViewBag.SearchText"
                       class="form-control"
                       placeholder="Search by title, description, or type..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>

                    <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">
                        Pending
                    </option>

                    <option value="In Review" selected="@(ViewBag.StatusFilter == "In Review")">
                        In Review
                    </option>

                    <option value="Approved" selected="@(ViewBag.StatusFilter == "Approved")">
                        Approved
                    </option>

                    <option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected")">
                        Rejected
                    </option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Department</label>
                <select name="departmentFilter" class="form-select">
                    <option value="">All Departments</option>

                    @foreach (var dept in ViewBag.Departments)
                    {
                        <option value="@dept.Id"
                                selected="@(ViewBag.DepartmentFilter == dept.Id)">
                            @dept.DepartmentName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-dark">
                    Filter
                </button>
            </div>

        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                Clear Filters
            </a>
        </div>
    </div>
</form>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No requests found.
    </div>
}
else
{
    <div class="table-responsive requests-table-wrapper">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Request Type</th>
                    <th>Status</th>
                    <th>Submitted By</th>
                    <th>Department</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>

                        <td class="fw-semibold">
                            @item.Title
                        </td>

                        <td>
                            @item.RequestType
                        </td>

                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (item.Status == "Rejected")
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Status</span>
                            }
                        </td>

                        <td>@item.SubmittedByName</td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                @item.Department?.DepartmentName
                            </span>
                        </td>

                        <td class="text-end">
                            <div class="dropdown text-end actions-dropdown">

                                <button class="btn btn-sm btn-dark dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    Manage
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Details"
                                           asp-route-id="@item.Id">
                                            Details
                                        </a>
                                    </li>

                                    @if (canManage)
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id">
                                                Edit
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item text-danger"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id">
                                                Delete
                                            </a>
                                        </li>
                                    }

                                    @if (canManage)
                                    {
                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <form asp-action="Approve"
                                                  asp-route-id="@item.Id"
                                                  method="post">
                                                <button type="submit" class="dropdown-item text-success">
                                                    Approve
                                                </button>
                                            </form>
                                        </li>

                                        <li>
                                            <form asp-action="Reject"
                                                  asp-route-id="@item.Id"
                                                  method="post">
                                                <button type="submit" class="dropdown-item text-danger">
                                                    Reject
                                                </button>
                                            </form>
                                        </li>

                                        <li>
                                            <form asp-action="MarkInReview"
                                                  asp-route-id="@item.Id"
                                                  method="post">
                                                <button type="submit" class="dropdown-item text-primary">
                                                    In Review
                                                </button>
                                            </form>
                                        </li>
                                    }

                                </ul>

                            </div>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchText="@ViewBag.SearchText"
                       asp-route-statusFilter="@ViewBag.StatusFilter"
                       asp-route-departmentFilter="@ViewBag.DepartmentFilter">
                        <i class="bi bi-chevron-left"></i>

                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchText="@ViewBag.SearchText"
                           asp-route-statusFilter="@ViewBag.StatusFilter"
                           asp-route-departmentFilter="@ViewBag.DepartmentFilter">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchText="@ViewBag.SearchText"
                       asp-route-statusFilter="@ViewBag.StatusFilter"
                       asp-route-departmentFilter="@ViewBag.DepartmentFilter">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>
    }
}