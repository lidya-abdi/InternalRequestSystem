@model List<InternalRequestSystem.Models.RequestLog>

@{
    ViewData["Title"] = "Activity Logs";
}

<div class="logs-page">

    <div class="form-header">
        <div>
            <span class="page-kicker">System activity</span>

            <h2 class="fw-bold mb-1">
                Activity Logs
            </h2>

            <p class="text-muted mb-0">
                Track request actions and workflow changes in one place.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Requests
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-clock-history"></i>
            <h5>No activity logs found</h5>
            <p>Actions performed on requests will appear here.</p>
        </div>
    }
    else
    {
        <div class="logs-card">

            @foreach (var log in Model)
            {
                var badgeClass =
                log.Action == "Created" ? "bg-success" :
                log.Action == "Updated" ? "bg-warning text-dark" :
                log.Action == "Deleted" ? "bg-danger" :
                log.Action == "Approved" ? "bg-success" :
                log.Action == "Rejected" ? "bg-danger" :
                log.Action == "In Review" ? "bg-primary" :
                "bg-secondary";

                <div class="log-item">

                    <div class="log-icon">
                        @if (log.Action == "Created")
                        {
                            <i class="bi bi-plus-circle"></i>
                        }
                        else if (log.Action == "Updated")
                        {
                            <i class="bi bi-pencil-square"></i>
                        }
                        else if (log.Action == "Deleted")
                        {
                            <i class="bi bi-trash"></i>
                        }
                        else if (log.Action == "Approved")
                        {
                            <i class="bi bi-check-circle"></i>
                        }
                        else if (log.Action == "Rejected")
                        {
                            <i class="bi bi-x-circle"></i>
                        }
                        else if (log.Action == "In Review")
                        {
                            <i class="bi bi-hourglass-split"></i>
                        }
                        else
                        {
                            <i class="bi bi-activity"></i>
                        }
                    </div>

                    <div class="log-content">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <span class="badge @badgeClass mb-2">
                                    @log.Action
                                </span>

                                <p class="mb-1 fw-semibold">
                                    @log.Description
                                </p>

                                <small class="text-muted">
                                    Performed by @log.PerformedBy
                                </small>
                            </div>

                            <small class="text-muted text-nowrap">
                                @log.ActionDate.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>