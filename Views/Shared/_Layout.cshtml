@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isLoggedIn =
        !string.IsNullOrEmpty(Context.Session.GetString("FullName")) &&
        !string.IsNullOrEmpty(Context.Session.GetString("Email"));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Internal Request System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="app-body">

    @if (isLoggedIn)
    {
        <div class="app-layout">

            <aside class="app-sidebar">

                <div>
                    <div class="sidebar-top">
                        <div class="sidebar-header">
                            <a class="sidebar-brand"
                               asp-controller="Home"
                               asp-action="Index">

                                <span class="brand-icon">IR</span>

                                <div class="brand-text">
                                    <span>Internal Request</span>
                                    <span>System</span>
                                </div>
                            </a>

                            <button type="button"
                                    class="sidebar-toggle"
                                    id="sidebarToggle">
                                ☰
                            </button>
                        </div>
                    </div>

                    <nav class="sidebar-nav">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Home" ? "active" : "")">
                            <i class="bi bi-speedometer2 sidebar-icon"></i>
                            <span>Dashboard</span>
                        </a>

                        <a asp-controller="Requests"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Requests" && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-file-earmark-text sidebar-icon"></i>
                            <span>Requests</span>
                        </a>

                        <a asp-controller="Requests"
                           asp-action="Logs"
                           class="sidebar-link @(currentController == "Requests" && currentAction == "Logs" ? "active" : "")">
                            <i class="bi bi-clock-history sidebar-icon"></i>
                            <span>Activity Logs</span>
                        </a>

                        <a asp-controller="Requests"
                           asp-action="Create"
                           class="sidebar-link sidebar-create @(currentController == "Requests" && currentAction == "Create" ? "active-create" : "")">
                            <i class="bi bi-plus-circle sidebar-icon"></i>
                            <span>New Request</span>
                        </a>

                    </nav>
                </div>

                <div class="sidebar-footer">
                    <p class="mb-2 text-white-50 small">
                        @Context.Session.GetString("FullName")
                    </p>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="sidebar-link logout-link">
                        <i class="bi bi-box-arrow-right sidebar-icon"></i>
                        <span>Logout</span>
                    </a>
                </div>

            </aside>

            <div class="app-page">
                <main class="app-main container-fluid">
                    <div class="app-content-card">
                        @RenderBody()
                    </div>
                </main>

                <footer class="text-center text-muted py-4">
                    <small>
                        &copy; 2026 - Internal Request & Approval Management System
                    </small>
                </footer>
            </div>

        </div>
    }
    else
    {
        <main class="container app-main">
            <div class="app-content-card">
                @RenderBody()
            </div>
        </main>

        <footer class="text-center text-muted py-4">
            <small>
                &copy; 2026 - Internal Request & Approval Management System
            </small>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (isLoggedIn)
    {
        <script>
            document.getElementById("sidebarToggle").addEventListener("click", function () {
                document.querySelector(".app-layout").classList.toggle("sidebar-collapsed");
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>