<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Internal Request System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="app-body">

    <header>
        <nav class="navbar navbar-expand-lg app-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">IR</span>
                    <span>Internal Request System</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Requests" asp-action="Index">
                                Requests
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Requests" asp-action="Logs">
                                Activity Logs
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-light btn-sm fw-semibold"
                               asp-controller="Requests"
                               asp-action="Create">
                                + New Request
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-warning"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container app-main">
        <div class="app-content-card">
            @RenderBody()
        </div>
    </main>

    <footer class="text-center text-muted py-4 mt-4">
        <small>&copy; 2026 - Internal Request & Approval Management System</small>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>