@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isLoggedIn =
        !string.IsNullOrEmpty(Context.Session.GetString("FullName")) &&
        !string.IsNullOrEmpty(Context.Session.GetString("Email"));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Internal Request System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="app-body">

    @if (isLoggedIn)
    {
        <div class="app-layout sidebar-collapsed">

            <aside class="app-sidebar">

                <button type="button" class="sidebar-toggle" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>

                <div class="sidebar-main">

                    <a class="sidebar-brand"
                       asp-controller="Home"
                       asp-action="Index">
                        <span class="brand-icon">IR</span>

                        <div class="brand-text">
                            <span>Internal</span>
                            <span>Request</span>
                            <span>System</span>
                        </div>
                    </a>

                    <nav class="sidebar-nav">

                        <div class="notification-wrapper">

                            <button class="sidebar-link notification-link"
                                    type="button"
                                    id="notificationToggle">

                                <div class="notification-icon-wrapper">

                                    <i class="bi bi-bell sidebar-icon"></i>

                                    <span class="notification-badge">
                                        3
                                    </span>

                                </div>

                                <span>Notifications</span>

                            </button>

                            <div class="notification-popup" id="notificationPopup">

                                <h6 class="fw-bold text-muted mb-3">
                                    Notifications
                                </h6>

                                <a asp-controller="Requests"
                                   asp-action="Logs"
                                   class="notification-item">

                                    View latest activities

                                </a>

                            </div>

                        </div>

                        <div class="sidebar-divider"></div>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Home" ? "active" : "")">
                            <i class="bi bi-speedometer2 sidebar-icon"></i>
                            <span>Dashboard</span>
                        </a>

                        <a asp-controller="Requests"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Requests" && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-file-earmark-text sidebar-icon"></i>
                            <span>Requests</span>
                        </a>

                        <a asp-controller="Requests"
                           asp-action="Logs"
                           class="sidebar-link @(currentController == "Requests" && currentAction == "Logs" ? "active" : "")">
                            <i class="bi bi-clock-history sidebar-icon"></i>
                            <span>Activity Logs</span>
                        </a>

                        <div class="sidebar-divider"></div>

                        <a asp-controller="Requests"
                           asp-action="Create"
                           class="sidebar-link sidebar-create @(currentController == "Requests" && currentAction == "Create" ? "active-create" : "")">
                            <i class="bi bi-plus-circle sidebar-icon"></i>
                            <span>New Request</span>
                        </a>

                    </nav>
                </div>

                <div class="sidebar-footer">
                    <p class="mb-2 text-white-50 small">
                        @Context.Session.GetString("FullName")
                    </p>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="sidebar-link logout-link">
                        <i class="bi bi-box-arrow-right sidebar-icon"></i>
                        <span>Logout</span>
                    </a>
                </div>

            </aside>

            <div class="app-page">
                <main class="app-main container-fluid">
                    <div class="app-content-card">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="toast-container position-fixed top-0 end-0 p-3">
                                <div class="toast align-items-center text-bg-success border-0" id="successToast"
                                     role="alert">
                                    <div class="d-flex">
                                        <div class="toast-body">
                                            @TempData["SuccessMessage"]
                                        </div>

                                        <button type="button"
                                                class="btn-close btn-close-white me-2 m-auto"
                                                data-bs-dismiss="toast">
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @RenderBody()
                    </div>
                </main>

                <footer class="text-center text-muted py-4">
                    <small>
                        &copy; 2026 - Internal Request & Approval Management System
                    </small>
                </footer>
            </div>

        </div>
    }
    else
    {
        <main class="container app-main">
            <div class="app-content-card">
                @RenderBody()
            </div>
        </main>

        <footer class="text-center text-muted py-4">
            <small>
                &copy; 2026 - Internal Request & Approval Management System
            </small>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (isLoggedIn)
    {
        <script>

            document.getElementById("sidebarToggle").addEventListener("click", function () {
                document.querySelector(".app-layout").classList.toggle("sidebar-collapsed");
            });

                        const notificationToggle =
                document.getElementById("notificationToggle");

            const notificationPopup =
                document.getElementById("notificationPopup");

            if (notificationToggle && notificationPopup) {

                notificationToggle.addEventListener("click", function (e) {

                    e.stopPropagation();

                    notificationPopup.classList.toggle("show");
                });

                document.addEventListener("click", function () {

                    notificationPopup.classList.remove("show");
                });
            }

            const toastElement = document.getElementById('successToast');

            if (toastElement) {

                const toast = new bootstrap.Toast(toastElement, {
                    delay: 3000
                });

                toast.show();
            }

        </script>
    }

    
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>