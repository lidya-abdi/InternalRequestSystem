<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Internal Request System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="app-body">

    <div class="app-layout">

        <!-- SIDEBAR -->

        <aside class="app-sidebar">

            <div>

                <a class="sidebar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">IR</span>

                    <span>Internal Request System</span>

                </a>

                <nav class="sidebar-nav mt-4">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link">
                        Dashboard
                    </a>

                    <a asp-controller="Requests"
                       asp-action="Index"
                       class="sidebar-link">
                        Requests
                    </a>

                    <a asp-controller="Requests"
                       asp-action="Logs"
                       class="sidebar-link">
                        Activity Logs
                    </a>

                    <a asp-controller="Requests"
                       asp-action="Create"
                       class="sidebar-link sidebar-create">
                        + New Request
                    </a>

                </nav>

            </div>

            <div class="sidebar-footer">

                <p class="mb-2 text-white-50 small">
                    @Context.Session.GetString("FullName")
                </p>

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="sidebar-link logout-link">
                    Logout
                </a>

            </div>

        </aside>

        <!-- MAIN CONTENT -->

        <div class="app-page">

            <main class="app-main container-fluid">

                <div class="app-content-card">
                    @RenderBody()
                </div>

            </main>

            <footer class="text-center text-muted py-4">
                <small>
                    &copy; 2026 - Internal Request & Approval Management System
                </small>
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>