@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isLoggedIn =
        !string.IsNullOrEmpty(Context.Session.GetString("FullName")) &&
        !string.IsNullOrEmpty(Context.Session.GetString("Email"));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Internal Request System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="app-body">

    @if (isLoggedIn)
    {
        <div class="app-layout">

            <aside class="app-sidebar">

                <div>
                    <div class="sidebar-top">
                        <div class="sidebar-header">

                            <a class="sidebar-brand"
                               asp-controller="Home"
                               asp-action="Index">

                                <span class="brand-icon">IR</span>

                                <div class="brand-text">
                                    <span>Internal Request</span>
                                    <span>System</span>
                                </div>
                            </a>

                            <div class="d-flex align-items-center gap-2">

                                <div class="dropdown">

                                    <button class="notification-btn"
                                            type="button"
                                            data-bs-toggle="dropdown">
                                        <i class="bi bi-bell"></i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end notification-dropdown shadow border-0">

                                        <li class="dropdown-header fw-bold">
                                            Notifications
                                        </li>

                                        <li>
                                            <a class="dropdown-item small" asp-controller="Requests" asp-action="Logs">
                                                View latest activities
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <span class="dropdown-item-text small text-muted">
                                                Request updates appear here.
                                            </span>
                                        </li>

                                    </ul>

                                </div>

                                <button type="button"
                                        class="sidebar-toggle"
                                        id="sidebarToggle">
                                    ☰
                                </button>

                            </div>

                        </div>
                    </div>

                    <nav class="sidebar-nav">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Home" ? "active" : "")">
                            <i class="bi bi-speedometer2 sidebar-icon"></i>
                            <span>Dashboard</span>
                        </a>

                        <a asp-controller="Requests"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Requests" && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-file-earmark-text sidebar-icon"></i>
                            <span>Requests</span>
                        </a>

                        <a asp-controller="Requests"
                           asp-action="Logs"
                           class="sidebar-link @(currentController == "Requests" && currentAction == "Logs" ? "active" : "")">
                            <i class="bi bi-clock-history sidebar-icon"></i>
                            <span>Activity Logs</span>
                        </a>

                        <a asp-controller="Requests"
                           asp-action="Create"
                           class="sidebar-link sidebar-create @(currentController == "Requests" && currentAction == "Create" ? "active-create" : "")">
                            <i class="bi bi-plus-circle sidebar-icon"></i>
                            <span>New Request</span>
                        </a>

                    </nav>
                </div>

                <div class="sidebar-footer">
                    <p class="mb-2 text-white-50 small">
                        @Context.Session.GetString("FullName")
                    </p>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="sidebar-link logout-link">
                        <i class="bi bi-box-arrow-right sidebar-icon"></i>
                        <span>Logout</span>
                    </a>
                </div>

            </aside>

            <div class="app-page">
                <main class="app-main container-fluid">
                    <div class="app-content-card">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="toast-container position-fixed top-0 end-0 p-3">
                                <div class="toast align-items-center text-bg-success border-0" id="successToast"
                                     role="alert">
                                    <div class="d-flex">
                                        <div class="toast-body">
                                            @TempData["SuccessMessage"]
                                        </div>

                                        <button type="button"
                                                class="btn-close btn-close-white me-2 m-auto"
                                                data-bs-dismiss="toast">
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @RenderBody()
                    </div>
                </main>

                <footer class="text-center text-muted py-4">
                    <small>
                        &copy; 2026 - Internal Request & Approval Management System
                    </small>
                </footer>
            </div>

        </div>
    }
    else
    {
        <main class="container app-main">
            <div class="app-content-card">
                @RenderBody()
            </div>
        </main>

        <footer class="text-center text-muted py-4">
            <small>
                &copy; 2026 - Internal Request & Approval Management System
            </small>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (isLoggedIn)
    {
        <script>

            document.getElementById("sidebarToggle").addEventListener("click", function () {
                document.querySelector(".app-layout").classList.toggle("sidebar-collapsed");
            });

            const toastElement = document.getElementById('successToast');

            if (toastElement) {

                const toast = new bootstrap.Toast(toastElement, {
                    delay: 3000
                });

                toast.show();
            }

        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>